APP_NAME=BookWise
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_HOST_DIRECT=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Dedicated PostgreSQL test database (used by phpunit via the pgsql_testing connection)
TEST_DATABASE_URL=
# TEST_DB_HOST=
# TEST_DB_PORT=5432
# TEST_DB_DATABASE=bookwise_test
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=
# TEST_DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CACHE_DB=0
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# Must exceed the queue worker --timeout (600s) so in-flight jobs are never re-reserved.
REDIS_QUEUE_RETRY_AFTER=630

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=book_wise@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────
# Wasmer Edge — production deployment
# ──────────────────────────────────────────────────────────────
# Set these in the Wasmer dashboard (app.yaml env or wasmer app secrets).
# Wasmer injects DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD
# automatically if you use their managed database. When using an external
# database (e.g. Neon), supply your own values for every DB_* variable.
#
# Required overrides for production:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://bookwise.<your-username>.wasmer.app
#   APP_KEY=<base64:…>
#   DB_HOST=<your-neon-pooler-host>
#   DB_DATABASE=neondb
#   DB_USERNAME=<your-neon-username>
#   DB_PASSWORD=<your-neon-password>
#   REDIS_HOST=tls://<your-upstash-endpoint>
#   REDIS_PASSWORD=<your-upstash-password>
#   SESSION_SECURE_COOKIE=true
#   MAIL_USERNAME=<your-mailtrap-username>
#   MAIL_PASSWORD=<your-mailtrap-password>
#   AWS_BUCKET=<your-r2-bucket>
#   AWS_ACCESS_KEY_ID=<your-r2-access-key>
#   AWS_SECRET_ACCESS_KEY=<your-r2-secret-key>
#   AWS_ENDPOINT=<your-r2-endpoint>
